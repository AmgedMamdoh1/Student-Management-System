{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Student Management System",
            "type": "shell",
            "command": "D:/mingw64/bin/g++.exe",
            "args": [
                "-g",
                "main.cpp",
                "File/file.cpp",
                "Student/student.cpp",
                "Student_mangment/student_mangment.cpp",
                "UI/ui.cpp",
                "-o",
                "StudentManagementSystem.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}